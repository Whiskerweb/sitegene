# Copier en .env.local et remplir. Ne pas commiter .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price récurrent Stripe pour l'abonnement « tout illimité » (9,99 €/mois)
STRIPE_SUBSCRIPTION_PRICE_ID=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Resend (emails transactionnels + prospection) ---
RESEND_API_KEY=
RESEND_FROM_TRANSACTIONAL="Akyra Team <noreply@akyra.io>"
RESEND_FROM_OUTREACH="Lucas — Akyra <lucas@go.akyra.io>"
RESEND_OUTREACH_REPLY_TO=lucas@akyra.io
RESEND_WEBHOOK_SECRET=

# --- Twenty CRM (synchro Akyra → Twenty) ---
# URL de base de l'instance Twenty (sans slash final), ex. https://crm.akyra.io
TWENTY_URL=
# Clé API générée dans Twenty → Settings → API & Webhooks
TWENTY_API_KEY=
# (Optionnel) valeur du stage « gagné » de l'objet Opportunity (défaut: WON)
TWENTY_WON_STAGE=
# (Optionnel) kill-switch : mettre 0 pour déployer le code sans pousser vers Twenty
TWENTY_SYNC_ENABLED=
# Réutilise CRON_SECRET (déjà défini) pour l'endpoint /api/cron/twenty-sync
