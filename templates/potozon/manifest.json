{
  "id": "potozon",
  "name": "Potozon — Experience Photography (pop / kinetic brutalism)",
  "photoSlots": 18,
  "photos": [
    { "slot": "p1", "role": "service", "required": true, "note": "Service 01 Portrait" },
    { "slot": "p2", "role": "service", "required": true, "note": "Service 04 Retouch & Grade" },
    { "slot": "p3", "role": "work", "required": true, "note": "Work 'Denim Reimagined'" },
    { "slot": "p4", "role": "service", "required": true, "note": "Service 03 Family + Work 'Zoe' + featuredQuote image 1" },
    { "slot": "p5", "role": "service", "required": true, "note": "Service 02 Events + Work 'Morning in Motion'" },
    { "slot": "p6", "role": "service", "required": true, "note": "Service 05 Brand + Work 'Gaia Essence'" },
    { "slot": "p7", "role": "avatar", "required": true, "note": "featuredQuote avatar + testimonial 1 avatar" },
    { "slot": "p8", "role": "avatar", "required": true, "note": "testimonial 2 avatar" },
    { "slot": "p9", "role": "avatar", "required": true, "note": "testimonial 3 avatar" },
    { "slot": "p10", "role": "gallery", "required": false, "note": "shipped asset; not currently referenced by content" },
    { "slot": "p11", "role": "gallery", "required": false, "note": "shipped asset; not currently referenced by content" },
    { "slot": "p12", "role": "gallery", "required": true, "note": "featuredQuote image 2" },
    { "slot": "p13", "role": "gallery", "required": false, "note": "shipped asset; not currently referenced by content" },
    { "slot": "p14", "role": "gallery", "required": false, "note": "shipped asset; not currently referenced by content" },
    { "slot": "c1", "role": "card", "required": true, "note": "OurGallery tinted card 1 (color #E5412A)" },
    { "slot": "c2", "role": "card", "required": true, "note": "OurGallery tinted card 2 (color #FFC400)" },
    { "slot": "c3", "role": "card", "required": true, "note": "OurGallery tinted card 3 (color #F15A24)" },
    { "slot": "c4", "role": "card", "required": true, "note": "OurGallery tinted card 4 (color #A99BE8)" }
  ],
  "fields": {
    "editable": [
      { "path": "brand", "label": "Nom de marque (navbar + footer + copyright)", "type": "text", "maxLen": 28 },
      { "path": "hero.line1", "label": "Hero title line 1", "type": "text", "maxLen": 20 },
      { "path": "hero.line2", "label": "Hero title line 2", "type": "text", "maxLen": 20 },
      { "path": "hero.sticker", "label": "Hero sticker text", "type": "text", "maxLen": 24 },
      { "path": "hero.ribbon", "label": "Hero ribbon word", "type": "text", "maxLen": 16 },
      { "path": "hero.subtitle", "label": "Hero mobile subtitle (1 sentence)", "type": "text", "maxLen": 90 },

      { "path": "navItems", "label": "Navigation labels (each must map to a section: about/portfolio/projects/studio/contact)", "type": "list", "maxLen": 16, "note": "Anchor = #<label lowercased>. Sections present: about, portfolio, projects, studio, contact. Do not add labels with no matching section (e.g. 'Blog' was removed)." },

      { "path": "featuredQuote.text", "label": "Featured quote", "type": "textarea", "maxLen": 260 },
      { "path": "featuredQuote.name", "label": "Quote author name", "type": "text", "maxLen": 40 },
      { "path": "featuredQuote.role", "label": "Quote author role", "type": "text", "maxLen": 40 },

      { "path": "scrollText", "label": "Big scroll-reveal statement", "type": "textarea", "maxLen": 260 },

      { "path": "servicesIntro", "label": "Services intro line", "type": "textarea", "maxLen": 140 },
      { "path": "services[].n", "label": "Service number (01..05)", "type": "text", "maxLen": 4 },
      { "path": "services[].name", "label": "Service name", "type": "text", "maxLen": 40 },
      { "path": "services[].desc", "label": "Service description", "type": "textarea", "maxLen": 200 },
      { "path": "services[].tags", "label": "Service tags", "type": "list", "maxLen": 24 },

      { "path": "collaborations", "label": "Marquee brand names", "type": "list", "maxLen": 20 },

      { "path": "works[].date", "label": "Work date", "type": "text", "maxLen": 24 },
      { "path": "works[].category", "label": "Work category", "type": "text", "maxLen": 40 },
      { "path": "works[].title", "label": "Work title", "type": "text", "maxLen": 40 },
      { "path": "works[].desc", "label": "Work description", "type": "textarea", "maxLen": 180 },

      { "path": "beyond.title", "label": "Stats section title", "type": "text", "maxLen": 40 },
      { "path": "beyond.body", "label": "Stats section body", "type": "textarea", "maxLen": 220 },
      { "path": "beyond.cta", "label": "Stats button label", "type": "text", "maxLen": 24 },
      { "path": "beyond.stats[].v", "label": "Stat value", "type": "text", "maxLen": 8 },
      { "path": "beyond.stats[].l", "label": "Stat label", "type": "text", "maxLen": 40 },

      { "path": "testimonials[].text", "label": "Testimonial text", "type": "textarea", "maxLen": 220 },
      { "path": "testimonials[].name", "label": "Testimonial author", "type": "text", "maxLen": 40 },
      { "path": "testimonials[].role", "label": "Testimonial role", "type": "text", "maxLen": 40 },

      { "path": "faqs[].q", "label": "FAQ question", "type": "text", "maxLen": 100 },
      { "path": "faqs[].a", "label": "FAQ answer", "type": "textarea", "maxLen": 300 },

      { "path": "textLeft", "label": "OurGallery left caption", "type": "textarea", "maxLen": 120 },
      { "path": "textRight.body", "label": "OurGallery right caption", "type": "textarea", "maxLen": 120 },
      { "path": "textRight.cta", "label": "OurGallery link label", "type": "text", "maxLen": 24 },

      { "path": "footer.title", "label": "Footer headline", "type": "textarea", "maxLen": 80 },
      { "path": "footer.email", "label": "Contact email (mailto)", "type": "text", "maxLen": 80 },
      { "path": "footer.socials", "label": "Social labels (rendered inert, no link)", "type": "list", "maxLen": 24 }
    ],
    "locked": [
      { "path": "scrollAccents", "reason": "DA: maps specific words in scrollText to brand accent colors (red/yellow/orange/purple). Structural; keys must match words in scrollText." },
      { "path": "services[].color", "reason": "DA brand color per service card. Locked palette." },
      { "path": "works[].color", "reason": "DA brand color per work card. Locked palette." },
      { "path": "beyond.stats[].color", "reason": "DA brand color per stat. Locked palette." },
      { "path": "cards[].color", "reason": "DA tint color of the OurGallery cards (mix-blend). Locked palette." },
      { "path": "cards[].rotate", "reason": "Structural rotation of OurGallery cards." },
      { "path": "cards[].marginTop", "reason": "Structural vertical offset of OurGallery cards." },
      { "path": "cards[].img", "reason": "Bound to photo slots c1..c4." },
      { "path": "featuredQuote.avatar", "reason": "Bound to photo slot p7." },
      { "path": "featuredQuote.images", "reason": "Bound to photo slots p4/p12." },
      { "path": "services[].img", "reason": "Bound to photo slots." },
      { "path": "works[].img", "reason": "Bound to photo slots." },
      { "path": "testimonials[].avatar", "reason": "Bound to photo slots p7/p8/p9." }
    ]
  }
}
